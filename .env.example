PUBLIC_TMDB_API_BASE_URL = https://api.themoviedb.org
TMDB_API_TOKEN =

# TheTVDB v4 project key (Dashboard → Account → API Keys)
TVDB_API_KEY =

# Managed subtitles: configure these as Worker secrets; local Bun has no rate limiter.
DEEPSEEK_API_KEY =
OPENAI_API_KEY =
# Worker variable: deepseek (default) or openai. Existing clients need no changes.
SUBTITLE_TRANSLATION_PROVIDER = deepseek

# MDBList: comma-separated keys, round-robin (https://mdblist.com/preferences)
MDBLIST_API_KEY =

R2_ACCOUNT_ID =
R2_ACCESS_KEY_ID =
R2_SECRET_ACCESS_KEY =
R2_BUCKET_NAME =
R2_CUSTOM_DOMAIN =

# EplayerX Blocks: admin review password for /blocks/admin
BLOCKS_ADMIN_PASSWORD =

# Playback timing admin: Cloudflare Access team URL, app audience and owner email.
TIMING_ACCESS_ISSUER =
TIMING_ACCESS_AUDIENCE =
TIMING_OWNER_EMAIL =
